<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
             http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>de.smartmirror</groupId>
    <artifactId>smartmirror</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>SmartMirror</name>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <main.class>main.GUI</main.class>
        <javafx.version>21.0.2</javafx.version>
        <google.api.client.version>1.34.1</google.api.client.version>
    </properties>

    <dependencies>
        <!--
            JavaFX is no longer bundled with the JDK since Java 11.
            OpenJFX must be declared as an explicit dependency.
        -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-fxml</artifactId>
            <version>${javafx.version}</version>
        </dependency>

        <!-- JSON parsing (used directly via org.json.JSONObject) -->
        <dependency>
            <groupId>org.json</groupId>
            <artifactId>json</artifactId>
            <version>20231013</version>
        </dependency>

        <!-- Google Calendar REST API client -->
        <dependency>
            <groupId>com.google.apis</groupId>
            <artifactId>google-api-services-calendar</artifactId>
            <version>v3-rev20220715-1.32.1</version>
        </dependency>

        <!-- Google API base client -->
        <dependency>
            <groupId>com.google.api-client</groupId>
            <artifactId>google-api-client</artifactId>
            <version>${google.api.client.version}</version>
        </dependency>

        <!-- OAuth2 for installed/desktop apps (AuthorizationCodeInstalledApp) -->
        <dependency>
            <groupId>com.google.oauth-client</groupId>
            <artifactId>google-oauth-client-java6</artifactId>
            <version>${google.api.client.version}</version>
        </dependency>

        <!-- Embedded Jetty for the OAuth2 redirect receiver (LocalServerReceiver) -->
        <dependency>
            <groupId>com.google.oauth-client</groupId>
            <artifactId>google-oauth-client-jetty</artifactId>
            <version>${google.api.client.version}</version>
        </dependency>

        <!-- Jackson2 transport for Google HTTP client (JacksonFactory) -->
        <dependency>
            <groupId>com.google.http-client</groupId>
            <artifactId>google-http-client-jackson2</artifactId>
            <version>1.43.3</version>
        </dependency>
    </dependencies>

    <build>
        <!--
            Non-standard layout: sources live directly in src/ with package "main".
            gui.fxml sits next to GUI.java in src/main/ — it is picked up as a
            resource and lands at main/gui.fxml on the classpath, which matches
            getClass().getResource("gui.fxml") called from class main.GUI.
        -->
        <sourceDirectory>src</sourceDirectory>

        <resources>
            <!-- FXML files (gui.fxml → main/gui.fxml on classpath) -->
            <resource>
                <directory>src</directory>
                <includes>
                    <include>**/*.fxml</include>
                </includes>
            </resource>
            <!-- Weather icons (src/res/*.png → res/*.png on classpath)
                 Loaded in GUI.java as new Image("/res/<name>.png") -->
            <resource>
                <directory>src/res</directory>
                <targetPath>res</targetPath>
                <includes>
                    <include>**/*.png</include>
                </includes>
            </resource>
        </resources>

        <plugins>
            <!-- Compiler: enforce Java 21 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <source>21</source>
                    <target>21</target>
                    <encoding>UTF-8</encoding>
                </configuration>
            </plugin>

            <!--
                javafx-maven-plugin — use for development:  mvn javafx:run
                This handles the OpenJFX module path automatically, which is
                required since JavaFX 11 is no longer on the boot classpath.
            -->
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <configuration>
                    <mainClass>${main.class}</mainClass>
                </configuration>
            </plugin>

            <!--
                Fat JAR via shade plugin — bundles all non-JavaFX deps.
                JavaFX native libs are platform-specific and cannot be bundled
                portably; run the JAR with:
                  java --module-path <javafx-sdk>/lib \
                       --add-modules javafx.controls,javafx.fxml \
                       -jar target/smartmirror-1.0-SNAPSHOT.jar
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.1</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>${main.class}</mainClass>
                                </transformer>
                                <!-- Merge Google service-loader files to avoid runtime errors -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>module-info.class</exclude>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
